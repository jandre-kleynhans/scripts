class Hub:
    def __init__(self) -> None:
        self.cond = threading.Condition()
        self.version = 0
        self.text = ""
        self.stop = threading.Event()

    def update(self, text: str, force: bool = False) -> None:
        with self.cond:
            if text != self.text or force:
                self.text = text
                self.version += 1
                self.cond.notify_all()


def read_markdown(path: Path) -> str:
    data = path.read_bytes()
    if data.startswith(b"\xef\xbb\xbf"):
        data = data[3:]
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return data.decode("utf-8", errors="replace")


def looks_like_rtf(text: str) -> bool:
    return text.lstrip().startswith(r"{\rtf")


def ensure_assets() -> Path:
    """Return a directory that holds the CSS and JS files."""
    if all((BUNDLE_DIR / name).is_file() for name in ASSETS):
        return BUNDLE_DIR
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    missing = []
    for name, (url, expected) in ASSETS.items():
        dest = CACHE_DIR / name
        if dest.is_file() and sha256_file(dest) == expected:
            continue
        missing.append((name, url, expected, dest))
    if missing:
        print("Downloading GitHub preview styles (first run only)…", file=sys.stderr)
        for name, url, expected, dest in missing:
            try:
                with urllib.request.urlopen(url, timeout=30) as resp:
                    data = resp.read()
            except Exception as exc:
                raise SystemExit(
                    f"md: could not download {name} from {url}\n{exc}"
                ) from exc
            digest = "sha256:" + hashlib.sha256(data).hexdigest()
            if digest != expected:
                raise SystemExit(
                    f"md: unexpected contents for {name} (got {digest}, wanted {expected})"
                )
            tmp = dest.with_suffix(dest.suffix + ".tmp")
            tmp.write_bytes(data)
            tmp.replace(dest)
    return CACHE_DIR


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def watch(path: Path, hub: Hub) -> None:
    last_key = None
    last_dir_key = None
    while not hub.stop.is_set():
        md_changed = False
        try:
            st = path.stat()
            key = (st.st_mtime_ns, st.st_size, st.st_ino)
            if key != last_key:
                hub.update(read_markdown(path))
                last_key = key
                md_changed = True
        except FileNotFoundError:
            # TextEdit and others save atomically: the file vanishes briefly.
            pass
        except OSError:
            pass

        # If a sibling image changes, refresh without waiting for a Markdown save.
        try:
            dir_key = directory_stamp(path.parent)
            if (
                not md_changed
                and last_dir_key is not None
                and dir_key != last_dir_key
            ):
                try:
                    text = read_markdown(path)
                except OSError:
                    text = hub.text
                hub.update(text, force=True)
            last_dir_key = dir_key
        except OSError:
            pass

        hub.stop.wait(POLL_SECONDS)


def directory_stamp(folder: Path) -> tuple:
    items = []
    try:
        entries = list(folder.iterdir())
    except OSError:
        return ()
    for p in entries:
        name = p.name
        if name.startswith(".") or name.endswith(("~", ".tmp", ".swp", ".DS_Store")):
            continue
        try:
            st = p.stat()
        except OSError:
            continue
        if p.is_file():
            items.append((name, st.st_mtime_ns, st.st_size, st.st_ino))
    items.sort()
    return tuple(items)


def pick_port(preferred: int) -> int:
    host = "127.0.0.1"
    if preferred:
        return bind_or_die(host, preferred)
    for port in range(8123, 8223):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind((host, port))
            except OSError:
                continue
            return port
    raise SystemExit("md: could not find a free port on 127.0.0.1")


def bind_or_die(host: str, port: int) -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind((host, port))
        except OSError as exc:
            raise SystemExit(f"md: port {port} is not available ({exc})") from exc
    return port


def safe_under(root: Path, relative: str) -> Path | None:
    if not relative or relative.endswith("/"):
        return None
    try:
        target = (root / relative).resolve()
        target.relative_to(root.resolve())
    except (OSError, ValueError):
        return None
    return target if target.is_file() else None


def open_browser(url: str) -> None:
    if sys.platform == "darwin":
        os.spawnlp(os.P_NOWAIT, "open", "open", url)
        return
    webbrowser.open(url)


PREVIEW_SUFFIXES = {".md", ".markdown", ".mdown", ".mkd", ".txt", ".html", ".htm"}


def preview_target(root: Path, start_file: Path, rel: str) -> Path | None:
    """Return a previewable file under root, or the starting file for an empty path."""
    rel = (rel or "").lstrip("/")
    if not rel:
        return start_file
    target = safe_under(root, rel)
    if target is None:
        return None
    if target.suffix.lower() not in PREVIEW_SUFFIXES:
        return None
    return target


def make_handler(md_path: Path, hub: Hub, asset_dir: Path):
    root = md_path.parent.resolve()

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt: str, *args) -> None:
            return

        def do_GET(self) -> None:
            parsed = urlparse(self.path)
            path = unquote(parsed.path)
            if path == "/":
                self._send_preview(md_path)
            elif path == "/events":
                self._sse(parsed.query)
            elif path.startswith("/asset/"):
                self._asset(path[len("/asset/") :])
            elif path == "/favicon.ico":
                self._send(204, "image/x-icon", b"")
            elif path.startswith("/files/"):
                self._raw_file(path[len("/files/") :])
            else:
                rel = path.lstrip("/")
                target = safe_under(root, rel)
                if target is None:
                    self._send(404, "text/plain; charset=utf-8", b"not found\n")
                elif target.suffix.lower() in PREVIEW_SUFFIXES:
                    self._send_preview(target)
                else:
                    self._raw_file(rel)

        def _send_preview(self, target: Path) -> None:
            title = target.name
            body = INDEX_HTML.replace("__TITLE__", html_escape(title)).encode("utf-8")
            self._send(200, "text/html; charset=utf-8", body)

        def _send(self, status: int, content_type: str, body: bytes, cache: bool = False) -> None:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header(
                "Cache-Control",
                "public, max-age=31536000" if cache else "no-store",
            )
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _asset(self, name: str) -> None:
            if name not in ASSETS:
                self._send(404, "text/plain; charset=utf-8", b"not found\n")
                return
            data = (asset_dir / name).read_bytes()
            ctype = {
                ".css": "text/css; charset=utf-8",
                ".js": "application/javascript; charset=utf-8",
            }.get(Path(name).suffix, "application/octet-stream")
            self._send(200, ctype, data, cache=True)

        def _raw_file(self, rel: str) -> None:
            target = safe_under(root, rel)
            if target is None:
                self._send(404, "text/plain; charset=utf-8", b"not found\n")
                return
            ctype, _ = mimetypes.guess_type(str(target))
            self._send(200, ctype or "application/octet-stream", target.read_bytes())

        def _sse(self, query: str) -> None:
            qs = parse_qs(query)
            rel = unquote(qs.get("file", [""])[0])
            target = preview_target(root, md_path, rel)
            if target is None:
                self._send(404, "text/plain; charset=utf-8", b"not found\n")
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "keep-alive")
            self.send_header("X-Accel-Buffering", "no")
            self.end_headers()
            last_key = None
            last_dir = None
            last_text = None
            version = 0
            last_ping = time.monotonic()
            try:
                while not hub.stop.is_set():
                    sent = False
                    try:
                        st = target.stat()
                        key = (st.st_mtime_ns, st.st_size, st.st_ino)
                        dir_key = directory_stamp(target.parent)
                        changed = key != last_key
                        images_changed = (
                            last_dir is not None and dir_key != last_dir and not changed
                        )
                        if changed:
                            last_text = read_markdown(target)
                            last_key = key
                        if changed or images_changed:
                            last_dir = dir_key
                            version += 1
                            payload = json.dumps(
                                {"v": version, "md": last_text or "", "file": target.name},
                                ensure_ascii=False,
                            )
                            self.wfile.write(f"data: {payload}\n\n".encode("utf-8"))
                            self.wfile.flush()
                            last_ping = time.monotonic()
                            sent = True
                        else:
                            last_dir = dir_key
                    except FileNotFoundError:
                        # TextEdit and others save atomically: the file vanishes briefly.
                        pass
                    except OSError:
                        pass
                    if not sent and time.monotonic() - last_ping >= 15:
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
                        last_ping = time.monotonic()
                    hub.stop.wait(POLL_SECONDS)
            except (BrokenPipeError, ConnectionResetError, OSError):
                return

    return Handler


def html_escape(text: str) -> str:
    return (
        text.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="md",
        description=(
            "Live-preview a Markdown file in your browser, rendered as "
            "GitHub Flavoured Markdown with GitHub's styling. "
            "Raw HTML is rendered along with the Markdown. Links to other pages in the same folder open in this preview."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="The page updates when you save the file. Press Ctrl+C to stop.",
    )
    p.add_argument("file", help="Markdown file to preview")
    p.add_argument(
        "-p",
        "--port",
        type=int,
        default=0,
        help="port to listen on (default: first free port from 8123)",
    )
    p.add_argument(
        "--no-open",
        action="store_true",
        help="do not open a browser",
    )
    p.add_argument("--version", action="version", version=f"md {VERSION}")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    try:
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except Exception:
        pass
    args = parse_args(sys.argv[1:] if argv is None else argv)
    path = Path(args.file).expanduser()
    try:
        path = path.resolve(strict=True)
    except FileNotFoundError:
        print(f"md: no such file: {args.file}", file=sys.stderr)
        return 1
    if not path.is_file():
        print(f"md: not a file: {args.file}", file=sys.stderr)
        return 1

    try:
        asset_dir = ensure_assets()
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 1

    hub = Hub()
    try:
        hub.update(read_markdown(path))
    except OSError as exc:
        print(f"md: could not read {path}: {exc}", file=sys.stderr)
        return 1

    port = pick_port(args.port)
    handler = make_handler(path, hub, asset_dir)
    server = ThreadingHTTPServer(("127.0.0.1", port), handler)
    url = f"http://127.0.0.1:{port}/"

    watcher = threading.Thread(target=watch, args=(path, hub), daemon=True)
    watcher.start()

    print(f"Previewing {path}")
    print(url)
    print("Updates when you save the file (Cmd+S in TextEdit). Press Ctrl+C to stop.")
    if looks_like_rtf(hub.text):
        print(
            "Warning: this looks like a Rich Text file. "
            "In TextEdit, choose Format > Make Plain Text, then save.",
            file=sys.stderr,
        )

    if not args.no_open:
        threading.Thread(target=lambda: (time.sleep(0.15), open_browser(url)), daemon=True).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        hub.stop.set()
        with hub.cond:
            hub.cond.notify_all()
        server.shutdown()
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
